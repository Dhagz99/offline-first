
generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum SyncStatus {
  PENDING
  PROCESSING
  SYNCED
  FAILED
  CONFLICT
}

enum SyncOperation {
  CREATE
  UPDATE
  DELETE
}

enum ConflictStatus {
  PENDING
  RESOLVED
  REJECTED
}

// ============================================
// USER MANAGEMENT
// ============================================

model User {
  id       String  @id @default(uuid()) @map("user_id") @db.Uuid
  name     String  @db.VarChar(150)
  username String  @unique @db.VarChar(100)
  email    String? @unique @db.VarChar(191)
  password String  @db.VarChar(255)

  isActive Boolean @default(true) @map("is_active")

  roles             UserRole[]
  branches          UserBranch[]
  resolvedConflicts SyncConflict[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// ============================================
// ROLE MANAGEMENT
// ============================================

model Role {
  id          String  @id @default(uuid()) @map("role_id") @db.Uuid
  name        String  @unique @map("role_name") @db.VarChar(100)
  description String? @db.Text

  users       UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

// ============================================
// USER ROLE
// ============================================

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id],onDelete: Cascade )

  role Role @relation( fields: [roleId],references: [id],onDelete: Cascade )

  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ============================================
// PERMISSION MANAGEMENT
// ============================================

model Permission {
  id          String  @id @default(uuid()) @map("permission_id") @db.Uuid
  code        String  @unique
  name        String  @unique @db.VarChar(100)
  description String? @db.Text

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

// ============================================
// ROLE PERMISSION
// ============================================

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role Role @relation(fields: [roleId],references: [id],onDelete: Cascade )

  permission Permission @relation( fields: [permissionId],  references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ============================================
// BRANCH MANAGEMENT
// ============================================

model Branch {
  id         String  @id @default(uuid()) @db.Uuid
  branchCode String  @unique @map("branch_code") @db.VarChar(50)
  branchName String  @map("branch_name") @db.VarChar(150)
  address    String? @db.Text

  isActive Boolean @default(true) @map("is_active")

  users UserBranch[]

  syncOutbox    SyncOutbox[]
  syncInbox     SyncInbox[]
  syncCursor    SyncCursor?
  syncConflicts SyncConflict[]
  changeLogs    SyncChangeLog[]
  credentials BranchCredential[]
  syncHeartbeat SyncHeartbeat?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("branches")
}


// ============================================
// BRANCH CREDENTIAL
// ============================================


model BranchCredential {
  id          String    @id @default(uuid()) @db.Uuid

  branchId    String    @map("branch_id") @db.Uuid

  keyPrefix   String    @map("key_prefix") @db.VarChar(32)
  keyHash     String    @unique @map("key_hash") @db.VarChar(64)

  isActive    Boolean   @default(true) @map("is_active")

  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  branch      Branch    @relation(  fields: [branchId], references: [id], onDelete: Restrict )

  @@index([branchId, isActive])
  @@map("branch_credentials")
}

model UserBranch {
  userId   String @map("user_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid

  user User @relation( fields: [userId], references: [id],onDelete: Cascade)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade )

  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([userId, branchId])
  @@index([branchId])
  @@map("user_branches")
}

// ============================================
// SYNCHRONIZATION OUTBOX
// ============================================

model SyncOutbox {
  id       String @id @default(uuid()) @db.Uuid
  branchId String @map("branch_id") @db.Uuid

  entityType String @map("entity_type") @db.VarChar(100)
  entityId   String @map("entity_id") @db.VarChar(191)

  operation SyncOperation
  payload   Json

  schemaVersion Int  @default(1) @map("schema_version")
  baseVersion   Int? @map("base_version")

  status   SyncStatus @default(PENDING)
  attempts Int        @default(0)

  lastError String? @map("last_error") @db.Text

  nextRetryAt DateTime? @map("next_retry_at")
  lockedAt    DateTime? @map("locked_at")
  lockedBy    String?   @map("locked_by")
  lockToken   String?   @map("lock_token") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  syncedAt  DateTime? @map("synced_at")

  branch Branch @relation( fields: [branchId],references: [id],onDelete: Restrict )

  @@index([branchId, status, createdAt])
  @@index([status, nextRetryAt])
  @@index([entityType, entityId])
  @@map("sync_outbox")
}

// ============================================
// SYNCHRONIZATION INBOX
// ============================================

model SyncInbox {
  id       String @id @db.Uuid
  branchId String @map("branch_id") @db.Uuid

  entityType String @map("entity_type") @db.VarChar(100)
  entityId   String @map("entity_id") @db.VarChar(191)

  operation SyncOperation

  payloadHash String @map("payload_hash") @db.VarChar(64)

  receivedAt DateTime @default(now()) @map("received_at")

  branch Branch @relation( fields: [branchId], references: [id], onDelete: Restrict )

  @@index([branchId, receivedAt])
  @@map("sync_inbox")
}

// ============================================
// SYNCHRONIZATION CURSOR
// ============================================

model SyncCursor {
  id       String @id @default(uuid()) @db.Uuid
  branchId String @unique @map("branch_id") @db.Uuid

  lastVersion BigInt @default(0) @map("last_version")

  lastPushAt DateTime? @map("last_push_at")
  lastPullAt DateTime? @map("last_pull_at")

  lastSuccessfulSyncAt DateTime? @map("last_successful_sync_at")

  lastError String? @map("last_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch Branch @relation(fields: [branchId],references: [id], onDelete: Restrict )

  @@map("sync_cursors")
}

// ============================================
// CENTRAL CHANGE LOG
// ============================================

model SyncChangeLog {
  version BigInt @id

  eventId String @unique @map("event_id") @db.Uuid

  // Null means a globally distributed event.
  branchId String? @map("branch_id") @db.Uuid

  entityType String @map("entity_type") @db.VarChar(100)
  entityId   String @map("entity_id") @db.VarChar(191)

  operation SyncOperation
  payload   Json

  schemaVersion Int @default(1) @map("schema_version")
  entityVersion Int @map("entity_version")

  createdAt DateTime @default(now()) @map("created_at")

  branch Branch? @relation( fields: [branchId],references: [id],onDelete: Restrict)

  @@index([branchId, version])
  @@index([entityType, entityId])
  @@map("sync_change_logs")
}

// ============================================
// CENTRAL VERSION COUNTER
// ============================================

model SyncVersionCounter {
  id          Int    @id
  lastVersion BigInt @default(0) @map("last_version")

  @@map("sync_version_counters")
}

// ============================================
// SYNCHRONIZATION CONFLICT
// ============================================

model SyncConflict {
  id       String @id @default(uuid()) @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  eventId  String @unique @map("event_id") @db.Uuid

  entityType String @map("entity_type") @db.VarChar(100)
  entityId   String @map("entity_id") @db.VarChar(191)

  operation SyncOperation

  localPayload   Json  @map("local_payload")
  centralPayload Json? @map("central_payload")

  localVersion   Int? @map("local_version")
  centralVersion Int? @map("central_version")

  reason String @db.Text

  status ConflictStatus @default(PENDING)

  resolution String? @db.Text

  resolvedBy String?   @map("resolved_by") @db.Uuid
  resolvedAt DateTime? @map("resolved_at")

  resolver User? @relation(fields: [resolvedBy], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch Branch @relation(fields: [branchId],references: [id], onDelete: Restrict )

  @@index([branchId, status])
  @@index([entityType, entityId])
  @@map("sync_conflicts")
}

// ============================================
// BRANCH SYNCHRONIZATION HEARTBEAT
// ============================================

model SyncHeartbeat {
  id String @id @default(uuid()) @db.Uuid

  branchId String @unique @map("branch_id") @db.Uuid

  localVersion BigInt @default(0) @map("local_version")

  lastKnownCentralVersion BigInt @default(0) @map("last_known_central_version")

  syncEnabled Boolean @default(true) @map("sync_enabled")

  intervalMs Int @default(10000) @map("interval_ms")

  consecutiveFailures Int @default(0)   @map("consecutive_failures")

  lastSuccessfulSyncAt DateTime?  @map("last_successful_sync_at")

  nextRetryAt DateTime? @map("next_retry_at")

  lastErrorCode String? @map("last_error_code") @db.VarChar(100)

  lastHeartbeatAt DateTime @default(now()) @map("last_heartbeat_at")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  branch Branch @relation(fields: [branchId],references: [id],onDelete: Restrict)

  @@index([lastHeartbeatAt])
}
